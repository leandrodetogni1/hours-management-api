generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  ENSINO
  PESQUISA
  EXTENSAO
}

enum Unity {
  SEMESTRE
  HORAS
  UNIDADE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  VERIFIED
}

enum ActivityClass {
  COMPLEMENTAR
  LIVRE
}

enum UserSituation {
  REGULAR
  FORMANDO
  FORMADO
}

enum Course {
  CIENCIA_DA_COMPUTACAO
  ENGENHARIA_DA_COMPUTACAO
}

model roles {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String  @unique @db.VarChar(50)
  users users[]
}

model activities {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId       String?           @map("authorid") @db.Uuid
  status         Status?           @default(PENDING)
  class          ActivityClass?
  activityTypeId String?           @map("activitytypeid") @db.Uuid
  event          String?           @db.VarChar(255)
  organization   String?           @db.VarChar(255)
  hours          Decimal?          @db.Decimal(10, 2)
  startDate      DateTime?         @map("startdate") @db.Date
  endDate        DateTime?         @map("enddate") @db.Date
  createdAt      DateTime?         @map("createdat") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime?         @map("updatedat") @default(now()) @db.Timestamp(6)
  users          users?            @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activity_types activity_types?   @relation(fields: [activityTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events         activity_events[]
}

model activity_events {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String     @map("activityid") @db.Uuid
  fromStatus Status?    @map("fromstatus")
  toStatus   Status     @map("tostatus")
  actorId    String     @map("actorid") @db.Uuid
  comment    String?    @db.VarChar(500)
  createdAt  DateTime   @default(now()) @map("createdat") @db.Timestamp(6)
  activities activities @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activityId, createdAt])
  @@index([actorId])
}

model activity_types {
  id                              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cod                             String       @unique @db.VarChar(10)
  label                           String       @db.VarChar(255)
  category                        Category?
  unity                           Unity?
  maxHoursInComplementarActivities Int?        @map("max_hours_complementar")
  maxHoursPerCertificateOrSemester Int?        @map("max_hours_per_certificate")
  activities                      activities[]
}


model users {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName  String       @map("firstname") @db.VarChar(255)
  lastName   String       @map("lastname") @db.VarChar(255)
  picture    String?      @db.VarChar(500)
  roleId     String       @map("roleid") @db.Uuid
  role       roles        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt  DateTime?    @map("createdat") @default(now()) @db.Timestamp(6)
  updatedAt  DateTime?    @map("updatedat") @default(now()) @db.Timestamp(6)
  email      String         @unique @db.VarChar(255)
  matricula  String?        @unique @db.VarChar(20)
  situation  UserSituation?
  course     Course?
  activities activities[]
}
