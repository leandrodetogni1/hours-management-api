generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  ENSINO
  PESQUISA
  EXTENSAO
}

enum Unity {
  SEMESTRE
  HORAS
  UNIDADE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  VERIFIED
}

enum ActivityClass {
  COMPLEMENTAR
  LIVRE
}

enum UserSituation {
  REGULAR
  FORMANDO
  FORMADO
}

enum Course {
  CIENCIA_DA_COMPUTACAO
  ENGENHARIA_DA_COMPUTACAO
}

enum CurriculumYear {
  Y2015
  Y2026
}

model roles {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique @db.VarChar(50)
  users       users[]
  invitations invitations[]
}

model invitations {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(255)
  roleId    String   @map("roleid") @db.Uuid
  role      roles    @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy String?  @map("createdby") @db.Uuid
  inviter   users?   @relation("InvitationInviter", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt DateTime @default(now()) @map("createdat") @db.Timestamp(6)
}

model activities {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId       String?           @map("authorid") @db.Uuid
  status         Status?           @default(PENDING)
  class          ActivityClass?
  activityTypeId String?           @map("activitytypeid") @db.Uuid
  event           String?          @db.VarChar(255)
  organization    String?          @db.VarChar(255)
  hours           Decimal?         @db.Decimal(10, 2)
  hoursEquivalent Decimal?         @map("hoursequivalent") @db.Decimal(10, 2)
  certificateUrl  String?          @map("certificateurl") @db.VarChar(500)
  startDate       DateTime?        @map("startdate") @db.Date
  endDate         DateTime?        @map("enddate") @db.Date
  createdAt      DateTime?         @map("createdat") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime?         @map("updatedat") @default(now()) @db.Timestamp(6)
  users          users?            @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activity_types activity_types?   @relation(fields: [activityTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events         activity_events[]
  file           activity_files?
}

model activity_files {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String     @unique @map("activityid") @db.Uuid
  filename   String     @db.VarChar(255)
  mimeType   String     @map("mimetype") @db.VarChar(100)
  size       Int
  data       Bytes
  createdAt  DateTime   @default(now()) @map("createdat") @db.Timestamp(6)
  activity   activities @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model activity_events {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String     @map("activityid") @db.Uuid
  fromStatus Status?    @map("fromstatus")
  toStatus   Status     @map("tostatus")
  actorId    String     @map("actorid") @db.Uuid
  comment    String?    @db.VarChar(500)
  createdAt  DateTime   @default(now()) @map("createdat") @db.Timestamp(6)
  activities activities @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor      users      @relation("EventActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activityId, createdAt])
  @@index([actorId])
}

model activity_types {
  id              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cod             String                            @unique @db.VarChar(10)
  label           String                            @db.VarChar(255)
  category        Category?
  unity           Unity?
  activities      activities[]
  curriculumRules activity_type_curriculum_rules[]
}

model activity_type_curriculum_rules {
  activityTypeId                   String         @map("activitytypeid") @db.Uuid
  curriculumYear                   CurriculumYear @map("curriculumyear")
  maxHoursTotal                    Int            @map("max_hours_total")
  maxHoursPerCertificateOrSemester Int            @map("max_hours_per_certificate")
  activityType                     activity_types @relation(fields: [activityTypeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  curriculum                       curricula      @relation(fields: [curriculumYear], references: [year], onDelete: Cascade, onUpdate: Cascade)

  @@id([activityTypeId, curriculumYear])
  @@map("activity_type_curriculum_rules")
}

model curricula {
  year                    CurriculumYear            @id
  minHoursPerCategory     Int?                      @map("min_hours_per_category")
  minCategoriesRequired   Int?                      @map("min_categories_required")
  excessToFreeMultiplier  Decimal                   @default(1.00) @map("excess_to_free_multiplier") @db.Decimal(4, 2)
  minFreeHours            Int                       @map("min_free_hours")
  courseRules             curriculum_course_rules[]
  activityTypeRules       activity_type_curriculum_rules[]
}

model curriculum_course_rules {
  curriculumYear CurriculumYear @map("curriculumyear")
  course         Course
  totalMin       Int            @map("total_min")
  totalMax       Int            @map("total_max")
  curriculum     curricula      @relation(fields: [curriculumYear], references: [year], onDelete: Cascade, onUpdate: Cascade)

  @@id([curriculumYear, course])
  @@map("curriculum_course_rules")
}


model users {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName  String       @map("firstname") @db.VarChar(255)
  lastName   String       @map("lastname") @db.VarChar(255)
  picture    String?      @db.VarChar(500)
  roleId     String       @map("roleid") @db.Uuid
  role       roles        @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt  DateTime?    @map("createdat") @default(now()) @db.Timestamp(6)
  updatedAt  DateTime?    @map("updatedat") @default(now()) @db.Timestamp(6)
  email      String         @unique @db.VarChar(255)
  matricula  String?        @unique @db.VarChar(8)
  situation       UserSituation?
  course          Course?
  curriculumYear  CurriculumYear? @map("curriculumyear")
  activities      activities[]
  invitationsCreated invitations[] @relation("InvitationInviter")
  eventsActed     activity_events[] @relation("EventActor")
  auditLogs       audit_logs[]      @relation("AuditActor")
}

model audit_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actorid") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entitytype") @db.VarChar(50)
  entityId   String?  @map("entityid") @db.VarChar(255)
  method     String?  @db.VarChar(10)
  path       String?  @db.VarChar(255)
  statusCode Int?     @map("statuscode")
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("useragent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("createdat") @db.Timestamp(6)
  actor      users?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}
