# Server
PORT=3000

# Database (Prisma + @prisma/adapter-pg)
# Dev:  local PostgreSQL
# Prod: Neon pooled connection string, set in the host env vars (Railway / Render / Fly).
#       Retrieve with: neonctl connection-string --project-id <id> --pooled
#       Format: postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hours_management?schema=public"

# CORS / frontend origin
FRONTEND_URL=http://localhost:3000

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me

# Google OAuth
GOOGLE_CLIENT_ID=

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
